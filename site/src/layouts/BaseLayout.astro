---
import '../styles/global.css';
import { defaultLocale, getAlternateLocale, getLocalizedPath, localeMeta, normalizeLocale, type SiteRoute } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  route: SiteRoute;
}

const { title, description, route } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const alternateLocale = getAlternateLocale(locale);
const currentPath = getLocalizedPath(locale, route);
const alternatePath = getLocalizedPath(alternateLocale, route);
const defaultPath = getLocalizedPath(defaultLocale, route);
---

<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={currentPath} />
    <link rel="alternate" hreflang={localeMeta[locale].hreflang} href={currentPath} />
    <link rel="alternate" hreflang={localeMeta[alternateLocale].hreflang} href={alternatePath} />
    <link rel="alternate" hreflang="x-default" href={defaultPath} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
