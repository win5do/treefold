---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const github = 'https://github.com/win5do/treefold';
const model = [
  {
    number: '01',
    name: 'Project',
    summary: '把代码与上下文放在一起',
    detail: '组织一个或多个 Git 仓库、可工作的目录范围，以及只读的 Context Directory。',
    example: 'repo · apps/web · docs',
  },
  {
    number: '02',
    name: 'Workspace',
    summary: '让每项 feature 独立推进',
    detail: '为一项工作创建独立的 branch 和 Git worktree，承载 Session、Todo 与交付状态。',
    example: 'feature/auth-flow',
  },
  {
    number: '03',
    name: 'Fork',
    summary: '把子任务并行展开',
    detail: 'Todo 可以创建一级 Fork。子任务在自己的 worktree 中完成，再合回父 Workspace。',
    example: 'Todo → Fork → Workspace',
  },
] as const;

const deliveryModes = [
  ['推送功能分支', '将 Workspace branch 推到远端，留给现有的代码评审流程。'],
  ['合并到本地基线', '在本机完成合并，并在操作前检查当前 Git 状态。'],
  ['保留现场', '暂不交付代码，保留工作区以便继续处理。'],
] as const;

const scenarios = [
  ['单仓库', '为不同 feature 创建独立 Workspace，避免 Agent 争用同一工作目录。', '01 / SINGLE REPO'],
  ['多仓库', '同一个 Workspace 为每个仓库管理对应的 worktree 与交付状态。', '02 / MULTI REPO'],
  ['Monorepo 与多目录', '按 apps/web、apps/api 等目录范围启动 Session，同时保持仓库级 Git 生命周期。', '03 / MONOREPO'],
  ['Context Directory', '把规范、笔记或其他非 Git 目录加入 Project，作为 Agent 的只读上下文。', '04 / CONTEXT'],
] as const;
---

<BaseLayout
  title="Treefold — 并行展开，干净收敛"
  description="Treefold 是免费开源的 macOS App。用 Project、Workspace 和 Fork 管理 Git worktree 并发开发，让 Codex 与 Shell Session、Todo 和长期进程各归其位。"
>
  <SiteHeader />
  <main>
    <section class="hero-glow relative overflow-hidden bg-ink text-white">
      <div class="hero-grid pointer-events-none absolute inset-0"></div>
      <div class="site-container relative grid gap-14 pt-16 pb-20 lg:min-h-[720px] lg:grid-cols-[minmax(0,0.94fr)_minmax(0,1.06fr)] lg:items-center lg:gap-10 lg:pt-14 lg:pb-24">
        <div class="relative z-10 max-w-[680px]">
          <div class="eyebrow text-accent">OPEN SOURCE <span class="text-white/30">/</span> FREE <span class="text-white/30">/</span> MACOS</div>
          <h1 class="mt-8 max-w-[720px] text-[clamp(3.1rem,5.6vw,5.8rem)] leading-[1.08] font-semibold tracking-[-0.075em]">
            让 Agent<br />并行开发，<br /><span class="text-accent">干净收敛。</span>
          </h1>
          <p class="mt-7 max-w-[600px] text-[16px] leading-[1.9] text-white/65 sm:text-[18px]">
            Treefold 把 Git worktree 变成可管理的开发工作流。每项工作独立推进，Codex 与 Shell Session 持续运行；从 Fork 的子任务到 Workspace 的交付，都有清晰的归属。
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="button-primary" href="/download">下载 macOS 版 <span aria-hidden="true">↗</span></a>
            <a class="button-secondary" href={github} target="_blank" rel="noopener noreferrer">GitHub 源码 <span aria-hidden="true">↗</span></a>
          </div>
          <p class="mt-5 text-xs leading-5 text-white/40">当前为私有预发布，访问 GitHub 和下载页中的资源需要仓库权限。</p>
          <div class="mt-12 flex flex-wrap gap-x-7 gap-y-3 border-t border-white/10 pt-6 text-xs font-medium text-white/55">
            <span>✓ 标准 Git branch 与 worktree</span>
            <span>✓ 项目状态保存在本机</span>
            <span>✓ 免费开源</span>
          </div>
        </div>

        <div class="relative z-10 min-w-0 lg:pl-3">
          <div class="absolute -top-10 right-8 h-32 w-32 rounded-full bg-accent/15 blur-3xl"></div>
          <div class="preview-shell relative overflow-hidden rounded-[14px] border border-white/20 bg-[#17221d]">
            <div class="flex h-[42px] items-center justify-between border-b border-white/10 bg-[#27352b] px-4">
              <div class="flex gap-1.5" aria-hidden="true"><span class="size-[7px] rounded-full bg-[#f3a69f]"></span><span class="size-[7px] rounded-full bg-[#e8c474]"></span><span class="size-[7px] rounded-full bg-[#a2cc83]"></span></div>
              <span class="font-mono text-[10px] tracking-[.1em] text-white/45">TREEFOLD / PROJECT</span>
              <span class="w-9"></span>
            </div>
            <div class="flex min-h-[370px] sm:min-h-[445px]">
              <div class="preview-sidebar shrink-0 border-r border-white/10 bg-[#19251f] px-3 py-5 sm:px-4">
                <div class="font-mono text-[9px] tracking-[.16em] text-white/35">PROJECT</div>
                <div class="mt-3 flex items-center gap-2 text-[11px] font-semibold text-white sm:text-xs"><span class="flex size-5 items-center justify-center rounded bg-[#67856e] text-[10px] text-white">A</span> atlas</div>
                <div class="mt-7 font-mono text-[9px] tracking-[.16em] text-white/35">WORKSPACES</div>
                <div class="mt-3 rounded-md bg-[#394d3d] px-2 py-2 text-[10px] font-semibold text-[#d9efcf] sm:text-[11px]">⌁ &nbsp; auth-flow</div>
                <div class="preview-tree-line relative mt-1 py-2 pr-1 pl-8 text-[9px] text-white/55 sm:text-[10px]">↳ &nbsp; validation</div>
                <div class="mt-1 px-2 py-2 text-[10px] text-white/50 sm:text-[11px]">⌁ &nbsp; api-cache</div>
                <div class="mt-7 hidden font-mono text-[9px] tracking-[.16em] text-white/35 sm:block">SESSIONS</div>
                <div class="mt-3 hidden text-[10px] text-white/65 sm:block">● &nbsp; Codex · auth-flow</div>
                <div class="mt-2 hidden text-[10px] text-white/45 sm:block">◌ &nbsp; Shell · api-cache</div>
              </div>
              <div class="preview-noise flex min-w-0 flex-1 flex-col px-3 py-5 sm:px-6 sm:py-6">
                <div class="flex items-start justify-between gap-2">
                  <div><div class="font-mono text-[9px] tracking-[.12em] text-accent/70">WORKSPACE / ACTIVE</div><div class="mt-1 text-lg font-semibold tracking-[-.04em] sm:text-2xl">auth-flow</div></div>
                  <div class="rounded-full border border-accent/30 bg-accent/10 px-2 py-1 font-mono text-[8px] text-accent sm:text-[9px]">ISOLATED</div>
                </div>
                <div class="mt-5 grid gap-2 sm:grid-cols-2">
                  <div class="rounded-lg border border-white/10 bg-white/[.04] p-3"><div class="font-mono text-[9px] text-white/35">BRANCH</div><div class="mt-1 truncate font-mono text-[10px] text-white/80 sm:text-[11px]">feature/auth-flow</div></div>
                  <div class="rounded-lg border border-white/10 bg-white/[.04] p-3"><div class="font-mono text-[9px] text-white/35">DELIVERY</div><div class="mt-1 text-[10px] text-white/80 sm:text-[11px]">Push feature branch</div></div>
                </div>
                <div class="mt-5 flex items-center justify-between border-b border-white/10 pb-2 text-[10px] sm:text-xs"><span class="font-semibold text-white/80">Todo / Fork</span><span class="text-white/35">01 / 02</span></div>
                <div class="mt-3 flex items-center gap-2 text-[10px] text-white/70 sm:text-[11px]"><span class="size-2 rounded-full bg-accent"></span><span class="truncate">处理表单校验与边界情况</span><span class="ml-auto shrink-0 rounded bg-accent/15 px-1.5 py-0.5 text-[9px] text-accent">Fork</span></div>
                <div class="mt-auto pt-6">
                  <div class="flex gap-3 border-b border-white/10 pb-2 font-mono text-[9px] text-white/40 sm:text-[10px]"><span class="border-b border-accent pb-2 text-accent">Codex</span><span>Shell</span><span>api · TTY</span></div>
                  <div class="mt-3 font-mono text-[9px] leading-[1.7] text-[#b2c4b2] sm:text-[10px]"><span class="text-accent">●</span> &nbsp; Fork validation ready<br /><span class="text-white/30">›</span> &nbsp; Running checks in isolated worktree<br /><span class="text-white/30">›</span> &nbsp; Waiting for next instruction<span class="text-accent">_</span></div>
                </div>
              </div>
            </div>
          </div>
          <p class="mt-4 text-center font-mono text-[10px] tracking-[.05em] text-white/35">WORKFLOW ILLUSTRATION · 产品流程示意</p>
        </div>
      </div>
    </section>

    <section id="model" class="scroll-mt-20 bg-paper py-24 sm:py-28">
      <div class="site-container">
        <div class="max-w-[820px]"><div class="section-kicker text-pine">01 / THE MODEL</div><h2 class="section-title mt-5">并行开发需要清楚的归属。</h2><p class="mt-6 max-w-2xl text-[16px] leading-8 text-muted">从 Project 到 Workspace，再到 Fork：代码、Session、Todo 和交付目标沿着同一结构组织。每一步都知道工作在哪里，以及完成后该回到哪里。</p></div>
        <div class="mt-12 grid gap-4 md:grid-cols-3">
          {model.map((item) => (
            <article class="model-card">
              <div class="relative z-10 flex items-center justify-between"><span class="section-kicker text-muted">{item.number} / MODEL</span><span class="font-mono text-2xl text-pine/45">↗</span></div>
              <h3 class="relative z-10 mt-9 text-3xl font-semibold tracking-[-.055em]">{item.name}</h3>
              <p class="relative z-10 mt-2 text-sm font-semibold text-pine">{item.summary}</p>
              <p class="relative z-10 mt-5 max-w-[270px] text-sm leading-7 text-muted">{item.detail}</p>
              <div class="relative z-10 mt-6 inline-block rounded bg-[#edf3ec] px-2.5 py-1.5 font-mono text-[10px] text-pine">{item.example}</div>
            </article>
          ))}
        </div>
        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-xl border border-[#d9e2d9] bg-[#edf2ea] px-6 py-5 text-sm text-[#465c4f]"><strong class="text-ink">Session 是执行现场。</strong><span>Codex 与 Shell Session 在 Project、Workspace 或 Fork 的目录中工作；可恢复的 Codex 历史留在对应的开发上下文。</span></div>
      </div>
    </section>

    <section id="workflow" class="scroll-mt-20 border-y border-[#dce5db] bg-[#eaf0e8] py-24 sm:py-28">
      <div class="site-container">
        <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end"><div class="max-w-[840px]"><div class="section-kicker text-pine">02 / FOLD THE WORK BACK</div><h2 class="section-title mt-5">展开任务。<br />把结果带回主线。</h2></div><p class="max-w-[330px] text-sm leading-7 text-muted">Treefold 让 Git 操作留在可见的工作流里：创建、同步、检查、交付，然后清理已完成的工作。</p></div>
        <div class="workflow-track mt-16 grid gap-8 md:grid-cols-4 md:gap-5">
          <div><span class="relative z-10 flex size-11 items-center justify-center rounded-full border border-pine bg-paper font-mono text-xs font-bold text-pine">01</span><h3 class="mt-6 text-xl font-semibold">创建 Workspace</h3><p class="mt-3 text-sm leading-7 text-muted">为 feature 建立独立 branch 与 worktree。</p></div>
          <div><span class="relative z-10 flex size-11 items-center justify-center rounded-full border border-pine bg-paper font-mono text-xs font-bold text-pine">02</span><h3 class="mt-6 text-xl font-semibold">并行处理 Todo</h3><p class="mt-3 text-sm leading-7 text-muted">从 Todo 创建 Fork，Agent 在独立目录完成子任务。</p></div>
          <div><span class="relative z-10 flex size-11 items-center justify-center rounded-full border border-pine bg-paper font-mono text-xs font-bold text-pine">03</span><h3 class="mt-6 text-xl font-semibold">合回父 Workspace</h3><p class="mt-3 text-sm leading-7 text-muted">完成 Fork 后，把子任务结果带回父工作区。</p></div>
          <div><span class="relative z-10 flex size-11 items-center justify-center rounded-full border border-pine bg-paper font-mono text-xs font-bold text-pine">04</span><h3 class="mt-6 text-xl font-semibold">按策略 Finish</h3><p class="mt-3 text-sm leading-7 text-muted">检查变更，按 Delivery Mode 交付或保留。</p></div>
        </div>
        <div class="mt-16 overflow-hidden rounded-2xl border border-[#cbd9cc] bg-white">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[#e1e9e0] px-6 py-4"><h3 class="text-base font-semibold">为每个仓库设置 Delivery Mode</h3><span class="font-mono text-[10px] text-muted">PER REPOSITORY</span></div>
          <div class="grid divide-y divide-[#e1e9e0] md:grid-cols-3 md:divide-x md:divide-y-0">
            {deliveryModes.map(([name, description], index) => (
              <div class="p-6"><div class="font-mono text-[11px] font-bold text-pine">0{index + 1} / {name}</div><p class="mt-3 text-sm leading-7 text-muted">{description}</p></div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="agents" class="scroll-mt-20 overflow-hidden bg-ink py-24 text-white sm:py-28">
      <div class="site-container grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center lg:gap-16">
        <div><div class="section-kicker text-accent">03 / AGENT INTEGRATION</div><h2 class="section-title mt-5">Agent 启动进程。<br />App 持续托管。</h2><p class="mt-6 max-w-[480px] text-[16px] leading-8 text-white/60">Agent 能读取当前 Project 与 Workspace 上下文、创建或更新 Todo，也能启动由 Treefold 集成的 amux 托管的进程。即使 Agent Session 已结束，进程仍可留在 App 中继续运行。</p><div class="mt-8 grid gap-3 text-sm text-white/75"><div class="flex gap-3"><span class="text-accent">↗</span><span>Todo 关联 Fork，子任务和代码有明确归属</span></div><div class="flex gap-3"><span class="text-accent">↗</span><span>实时查看命令日志，TTY 进程可继续输入</span></div><div class="flex gap-3"><span class="text-accent">↗</span><span>在 App 内查看、重启或停止托管进程</span></div></div><p class="mt-8 text-xs leading-6 text-white/35">退出 App 后是否保持进程运行，由 amux 设置决定。</p></div>
        <div class="overflow-hidden rounded-xl border border-white/15 bg-[#1c2922] shadow-[0_30px_80px_#0007]"><div class="flex items-center justify-between border-b border-white/10 px-5 py-4"><div class="flex items-center gap-2"><span class="size-2 rounded-full bg-accent"></span><strong class="text-sm">api · TTY</strong></div><span class="rounded-full bg-accent/10 px-2.5 py-1 font-mono text-[10px] text-accent">RUNNING</span></div><div class="space-y-3 px-5 py-5 font-mono text-[11px] leading-6 sm:px-8 sm:py-7 sm:text-xs"><div class="terminal-line"><span class="line-number">01</span><span><span class="text-accent">$</span> amux run --name api -- cargo run</span></div><div class="terminal-line"><span class="line-number">02</span><span class="text-white/40">Compiling service...</span></div><div class="terminal-line"><span class="line-number">03</span><span class="text-white/40">Listening on 127.0.0.1:3001</span></div><div class="terminal-line"><span class="line-number">04</span><span class="text-[#a6d7a3]">GET /api/health 200</span></div><div class="terminal-line"><span class="line-number">05</span><span class="text-white/50">Agent Session 已结束 · 进程继续运行</span></div></div><div class="flex flex-wrap items-center justify-between gap-2 border-t border-white/10 px-5 py-4 text-[11px] text-white/45 sm:px-8"><span>归属：Project / atlas / api</span><span>LOGS · INPUT · STOP</span></div></div>
      </div>
    </section>

    <section id="scenarios" class="scroll-mt-20 bg-paper py-24 sm:py-28"><div class="site-container"><div class="max-w-[770px]"><div class="section-kicker text-pine">04 / FITS YOUR CODEBASE</div><h2 class="section-title mt-5">代码怎么组织，<br />工作就怎么展开。</h2><p class="mt-6 text-[16px] leading-8 text-muted">从一个仓库到多个仓库，Treefold 管理真实的 Git worktree，同时让 Session 从合适的目录开始。</p></div><div class="mt-12 grid gap-4 md:grid-cols-2">{scenarios.map(([name, description, tag]) => (<article class="rounded-2xl border border-[#dce5db] bg-white p-7 sm:p-8"><div class="font-mono text-[10px] font-bold tracking-[.12em] text-pine">{tag}</div><h3 class="mt-8 text-2xl font-semibold tracking-[-.04em]">{name}</h3><p class="mt-4 max-w-[470px] text-sm leading-7 text-muted">{description}</p></article>))}</div></div></section>

    <section class="bg-[#d8e9d2] py-20 sm:py-24"><div class="site-container flex flex-col justify-between gap-8 lg:flex-row lg:items-end"><div><div class="section-kicker text-pine">FREE & OPEN SOURCE</div><h2 class="mt-5 max-w-[750px] text-[clamp(2.4rem,5vw,4.8rem)] leading-[1.1] font-semibold tracking-[-.065em]">把并行的工作，<br />收成可以交付的结果。</h2><p class="mt-5 text-sm text-[#4d6754]">Treefold for macOS · 本地优先 · AGPL-3.0-only</p></div><div class="flex flex-wrap gap-3"><a href="/download" class="button-primary !bg-ink !text-white hover:!bg-pine">前往下载 <span aria-hidden="true">↗</span></a><a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[54px] items-center justify-center gap-3 rounded-lg border border-pine/40 px-5 text-sm font-bold text-ink transition-colors hover:border-pine">查看源码 ↗</a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
