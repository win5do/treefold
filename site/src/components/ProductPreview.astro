---
import AgentIcon from './AgentIcon.astro';
import { normalizeLocale } from '../i18n/config';
import { productPreviewCopy } from '../i18n/productPreview';
const copy = productPreviewCopy[normalizeLocale(Astro.currentLocale)];
---
<section class="product-stage" aria-label={copy.label}>
  <fieldset class="workflow-switch">
    <legend class="sr-only">{copy.views}</legend>
    {copy.scenes.map((scene, index) => <label><input type="radio" name="workflow-scene" value={index} checked={index === 0} /><span><b>0{index + 1}</b>{scene}</span></label>)}
  </fieldset>
  <div class="workflow-window">
    <div class="workflow-titlebar"><span aria-hidden="true">● ● ●</span><strong>Treefold</strong><small>{copy.illustration}</small></div>
    <div class="workflow-body">
      <aside class="workflow-tree" aria-label="Project / Workspace / Fork">
        <small>Project</small><strong>atlas</strong>
        <div class="tree-indent"><small>Workspace</small><strong class="tree-selected">auth-flow</strong><span>Codex · Shell</span>
          <div class="tree-indent"><small>Fork</small><strong>validation</strong><span>Codex</span><strong>api-tests</strong><span>Claude Code</span></div>
        </div>
      </aside>
      <div class="workflow-main">
        <header><small>Workspace / auth-flow</small><h3>{copy.task}</h3></header>
        <section class="workflow-scene workflow-split" aria-label={copy.scenes[0]}>
          <div class="scene-heading"><strong>Todo</strong><span>02</span></div>
          <div class="task-card"><i aria-hidden="true">○</i><strong>{copy.validation}</strong><span class="task-action">{copy.create} ↗</span></div>
          <div class="fork-connector" aria-hidden="true">↓</div>
          <div class="execution-card"><small>Fork</small><strong>validation</strong><code>fork/validation</code><p>{copy.isolation}</p></div>
          <div class="task-secondary"><i aria-hidden="true">○</i> {copy.tests}<span>→ api-tests</span></div>
        </section>
        <section class="workflow-scene workflow-parallel" aria-label={copy.scenes[1]}>
          <div class="scene-heading"><strong>Fork</strong><span>02 · {copy.running}</span></div>
          {[['validation', 'codex', 'Codex', copy.validation], ['api-tests', 'claude_code', 'Claude Code', copy.tests]].map(([name, kind, agent, task]) => <div class="execution-card"><div class="agent-line"><AgentIcon kind={kind as 'codex' | 'claude_code'} /><strong>{agent}</strong><span class="running-dot">{copy.running}</span></div><code>Fork / {name}</code><p>{task}</p><div class="code-trace">{name === 'validation' ? 'src/auth/session.ts  +24 −6' : 'tests/auth/api.test.ts  +48'}</div></div>)}
          <p class="scene-footnote">{copy.shared}</p>
        </section>
        <section class="workflow-scene workflow-deliver" aria-label={copy.scenes[2]}>
          <div class="scene-heading"><strong>{copy.review}</strong><span>validation</span></div>
          <div class="diff-preview"><code>src/auth/session.ts</code><pre><span>− return session.user</span><b>+ validateSession(session)</b><b>+ return session.user</b></pre></div>
          <p class="test-result">✓ {copy.passed}</p>
          <div class="delivery-route"><span>Fork<strong>validation</strong></span><b aria-hidden="true">→</b><span>Workspace<strong>auth-flow</strong></span></div>
          <div class="delivery-action">{copy.merge} ↗</div>
          <p class="scene-footnote">{copy.retained}</p>
        </section>
      </div>
    </div>
  </div>
  <div class="workflow-captions" aria-live="polite">{copy.captions.map((caption, index) => <p class={`workflow-caption caption-${index}`}>{caption}</p>)}</div>
</section>
<style>
  .product-stage { min-width: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .workflow-switch { display: flex; gap: 6px; padding: 0; margin: 0 0 16px; border: 0; }
  .workflow-switch label { flex: 1; min-width: 0; cursor: pointer; }
  .workflow-switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .workflow-switch label > span { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 11px 5px; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); font-size: 12px; }
  .workflow-switch b { font: 10px var(--font-mono); color: var(--accent-bright); }
  .workflow-switch input:checked + span { background: var(--accent-soft); border-color: var(--accent); color: var(--text); }
  .workflow-switch input:focus-visible + span { outline: 2px solid var(--accent-bright); outline-offset: 3px; }
  .workflow-window { border: 1px solid var(--border-strong); border-radius: 12px; overflow: hidden; background: var(--surface); box-shadow: 0 30px 80px rgb(0 0 0 / .35); }
  .workflow-titlebar { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: var(--surface-bright); border-bottom: 1px solid var(--border); font-size: 12px; }
  .workflow-titlebar > span { color: var(--subtle); font-size: 9px; letter-spacing: 3px; }
  .workflow-titlebar small { margin-left: auto; color: var(--muted); font-size: 10px; }
  .workflow-body { display: grid; grid-template-columns: 155px minmax(0, 1fr); }
  .workflow-tree { padding: 22px 12px; border-right: 1px solid var(--border); background: var(--surface-raised); font-size: 12px; }
  .workflow-tree small { display: block; margin: 0 0 8px; color: var(--muted); font-size: 10px; }
  .workflow-tree strong, .workflow-tree span { display: block; padding: 6px 4px; }
  .workflow-tree span { color: var(--muted); font-size: 10px; }
  .tree-indent { border-left: 1px solid var(--border-strong); margin: 14px 0 0 4px; padding-left: 9px; }
  .tree-selected { background: var(--accent-soft); border-radius: 4px; color: var(--accent-bright); }
  .workflow-main { padding: 24px; min-width: 0; }
  .workflow-main header small { color: var(--muted); font-size: 11px; }
  .workflow-main h3 { margin: 8px 0 24px; font-size: 21px; line-height: 1.3; letter-spacing: -.03em; }
  .workflow-scene { display: none; min-height: 305px; font-size: 12px; }
  .scene-heading { display: flex; justify-content: space-between; gap: 8px; margin-bottom: 14px; }
  .scene-heading > span { color: var(--muted); font-size: 10px; }
  .task-card, .execution-card { padding: 14px; border: 1px solid var(--border-strong); border-radius: 8px; background: var(--surface-raised); }
  .task-card i, .task-secondary i { color: var(--accent-bright); font-style: normal; margin-right: 6px; }
  .task-action { display: block; color: var(--accent-bright); margin: 12px 0 0 20px; }
  .fork-connector { padding: 5px 20px; color: var(--accent); }
  .execution-card > small { color: var(--accent-bright); margin-right: 10px; }
  .execution-card code { display: block; color: var(--muted); margin-top: 9px; font-size: 10px; }
  .execution-card p { margin: 10px 0 0; color: var(--muted); line-height: 1.5; }
  .execution-card + .execution-card { margin-top: 12px; }
  .task-secondary { margin-top: 18px; color: var(--muted); line-height: 1.7; }
  .task-secondary > span { display: block; padding-left: 20px; font-size: 10px; }
  .agent-line { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
  .agent-line :global(svg) { width: 18px; height: 18px; }
  .running-dot { color: var(--green); font-size: 10px; margin-left: auto; }
  .code-trace { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--border); font: 10px var(--font-mono); color: var(--green); overflow-wrap: anywhere; }
  .scene-footnote { color: var(--muted); font-size: 10px; line-height: 1.7; margin: 16px 0 0; }
  .diff-preview { border: 1px solid var(--border); border-radius: 8px; overflow: hidden; font-size: 10px; }
  .diff-preview > code { display: block; padding: 12px; background: var(--surface-bright); }
  .diff-preview pre { margin: 0; padding: 12px; line-height: 1.9; overflow-x: auto; }
  .diff-preview pre > * { display: block; font-weight: 400; }
  .diff-preview pre span { color: var(--red); }
  .diff-preview pre b, .test-result { color: var(--green); }
  .test-result { font-size: 11px; margin: 16px 0; }
  .delivery-route { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 14px 0; color: var(--muted); font-size: 10px; }
  .delivery-route strong { display: block; margin-top: 4px; color: var(--text); font-size: 12px; }
  .delivery-route > b { color: var(--accent-bright); font-size: 20px; }
  .delivery-action { padding: 12px; border: 1px solid var(--accent); border-radius: 6px; background: var(--accent-soft); color: var(--accent-bright); text-align: center; }
  .workflow-caption { display: none; color: var(--muted); font-size: 12px; line-height: 1.8; margin: 16px 0 0; min-height: 44px; }
  .product-stage:has(input[value="0"]:checked) :is(.workflow-split, .caption-0), .product-stage:has(input[value="1"]:checked) :is(.workflow-parallel, .caption-1), .product-stage:has(input[value="2"]:checked) :is(.workflow-deliver, .caption-2) { display: block; }
  @media(max-width: 600px) {
    .workflow-body { grid-template-columns: 1fr; }
    .workflow-tree { display: none; }
    .workflow-main { padding: 20px; }
    .workflow-switch label > span { flex-direction: column; gap: 5px; font-size: 11px; min-height: 58px; }
    .workflow-titlebar { gap: 8px; padding-inline: 12px; }
    .workflow-titlebar small { font-size: 9px; }
  }
</style>
