---
interface Props { locale?: 'zh' | 'en'; }
const { locale = 'zh' } = Astro.props;
const isEnglish = locale === 'en';
const home = isEnglish ? '/en/' : '/';
const download = isEnglish ? '/en/download/' : '/download/';
const github = 'https://github.com/win5do/treefold';
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <div>
      <a href={home} class="brand">
        <img src="/favicon.png" width="28" height="28" alt="" />
        <span>Treefold</span>
      </a>
      <p>{isEnglish ? 'Run agents in parallel. Fold the work back cleanly.' : '并行展开，干净收敛。'}</p>
      <small>{isEnglish ? 'Free and open source · AGPL-3.0-only' : '免费开源 · AGPL-3.0-only'}</small>
    </div>
    <nav aria-label={isEnglish ? 'Footer navigation' : '页脚导航'}>
      <a href={home}>{isEnglish ? 'Home' : '首页'}</a>
      <a href={download}>{isEnglish ? 'Download' : '下载'}</a>
      <a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={`${github}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer">{isEnglish ? 'License' : '许可证'} ↗</a>
    </nav>
  </div>
</footer>
