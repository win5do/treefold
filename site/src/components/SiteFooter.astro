---
import { siteLinks } from '../config/site';
import { commonCopy } from '../i18n/common';
import { getLocalizedPath, normalizeLocale } from '../i18n/config';

const locale = normalizeLocale(Astro.currentLocale);
const copy = commonCopy[locale].footer;
const home = getLocalizedPath(locale, 'home');
const download = getLocalizedPath(locale, 'download');
---

<footer class="site-footer">
  <div class="site-container footer-inner">
    <div>
      <a href={home} class="brand">
        <img src="/favicon.png" width="28" height="28" alt="" />
        <span>Treefold</span>
      </a>
      <p>{copy.tagline}</p>
      <small>{copy.licenseSummary}</small>
    </div>
    <nav aria-label={copy.navigationLabel}>
      <a href={home}>{copy.home}</a>
      <a href={download}>{copy.download}</a>
      <a href={siteLinks.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={siteLinks.license} target="_blank" rel="noopener noreferrer">{copy.license} ↗</a>
    </nav>
  </div>
</footer>
