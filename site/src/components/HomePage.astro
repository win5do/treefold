---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { siteLinks } from '../config/site';
import { getLocalizedPath, normalizeLocale } from '../i18n/config';
import { homeCopy } from '../i18n/home';

const locale = normalizeLocale(Astro.currentLocale);
const copy = homeCopy[locale];
const download = getLocalizedPath(locale, 'download');
---

<BaseLayout title={copy.title} description={copy.description} route="home">
  <SiteHeader />
  <main>
    <section class="hero section-grid">
      <div class="hero-orb hero-orb-one"></div>
      <div class="hero-orb hero-orb-two"></div>
      <div class="site-container hero-content">
        <div class="hero-copy">
          <div class="eyebrow"><span></span>{copy.eyebrow}</div>
          <h1><span>{copy.heroTitle[0]}</span><span class="gradient-text">{copy.heroTitle[1]}</span></h1>
          <p>{copy.heroBody}</p>
          <div class="hero-actions">
            <a class="button button-primary" href={download}>{copy.download}<span aria-hidden="true">↗</span></a>
            <a class="button button-secondary" href={siteLinks.github} target="_blank" rel="noopener noreferrer">{copy.source}<span aria-hidden="true">↗</span></a>
          </div>
          <small class="private-note">{copy.privateNote}</small>
          <div class="proof-row">{copy.proof.map((item) => <span><i aria-hidden="true"></i>{item}</span>)}</div>
        </div>

        <div class="product-stage" role="img" aria-label={copy.workflowIllustrationLabel}>
          <div class="product-window">
            <div class="window-bar"><div class="window-dots"><span></span><span></span><span></span></div><span>TREEFOLD / ATLAS</span><span class="window-status">● LIVE</span></div>
            <div class="product-body">
              <aside class="product-sidebar">
                <div class="ui-label">PROJECT</div>
                <div class="project-row"><span class="project-icon">A</span><strong>atlas</strong></div>
                <div class="ui-label spaced">WORKSPACES</div>
                <div class="tree-row active"><span>◇</span> auth-flow</div>
                <div class="tree-row child"><span>↳</span> validation</div>
                <div class="tree-row"><span>◇</span> api-cache</div>
                <div class="ui-label spaced hide-small">SESSIONS</div>
                <div class="session-row hide-small"><i></i> Codex · auth-flow</div>
                <div class="session-row muted hide-small"><i></i> Shell · api-cache</div>
              </aside>
              <div class="product-main">
                <div class="workspace-heading"><div><span>WORKSPACE / ACTIVE</span><strong>auth-flow</strong></div><em>ISOLATED</em></div>
                <div class="workspace-stats"><div><span>BRANCH</span><code>feature/auth-flow</code></div><div><span>DELIVERY</span><strong>Squash merge</strong></div></div>
                <div class="todo-heading"><strong>Todo / Fork</strong><span>01 / 02</span></div>
                <div class="todo-row"><i></i><span>{copy.todoExample}</span><em>Fork</em></div>
                <div class="terminal-preview">
                  <div class="terminal-tabs"><strong>Codex</strong><span>Shell</span><span>api · TTY</span></div>
                  <code><b>●</b> {copy.forkReady}<br /><span>›</span> {copy.runningChecks}<br /><span>›</span> {copy.waitingInstruction}<span class="cursor">_</span></code>
                </div>
              </div>
            </div>
          </div>
          <div class="stage-shadow"></div>
        </div>
      </div>
    </section>

    <section id="model" class="content-section section-grid">
      <div class="site-container">
        <header class="section-heading"><div class="kicker">01 / {copy.modelKicker}</div><h2>{copy.modelTitle}</h2><p>{copy.modelBody}</p></header>
        <div class="model-grid">
          {copy.model.map(([number, name, summary, detail]) => <article class="feature-card"><span class="card-number">{number}</span><div class="model-icon" aria-hidden="true"><span></span><span></span><span></span></div><h3>{name}</h3><strong>{summary}</strong><p>{detail}</p></article>)}
        </div>
        <div class="inline-note"><span class="pulse-dot"></span>{copy.sessionNote}</div>
      </div>
    </section>

    <section id="git" class="content-section section-grid border-section">
      <div class="site-container split-layout">
        <div>
          <header class="section-heading compact"><div class="kicker">02 / {copy.gitKicker}</div><h2>{copy.gitTitle}</h2><p>{copy.gitBody}</p></header>
          <div class="feature-list">{copy.gitFeatures.map(([name, detail], index) => <article><span>0{index + 1}</span><div><h3>{name}</h3><p>{detail}</p></div></article>)}</div>
        </div>
        <div class="git-window" role="img" aria-label={copy.gitIllustrationLabel}>
          <div class="git-tabs"><div><span>Changes</span><strong>Git History</strong></div><code>feature/auth-flow</code></div>
          <div class="git-content">
            <div class="commit-list">
              <div class="commit selected"><span class="commit-line"></span><i></i><div><strong>Validate session ownership</strong><small>Mina · 09:42 · 4 {copy.gitExample.files} <b>+86</b> <em>−14</em></small></div><code>8f3ab21</code></div>
              <div class="commit selected"><span class="commit-line"></span><i></i><div><strong>Add delivery preflight checks</strong><small>Leo · {copy.gitExample.yesterday} · 2 {copy.gitExample.files} <b>+31</b> <em>−5</em></small></div><code>62bd908</code></div>
              <div class="commit"><span class="commit-line"></span><i></i><div><strong>Refine Todo assignment</strong><small>Mina · {copy.gitExample.monday} · 6 {copy.gitExample.files} <b>+104</b> <em>−28</em></small></div><code>1ca77ef</code></div>
            </div>
            <div class="context-menu"><span>{copy.gitExample.commitActions}</span><div>View Diff</div><div>Copy Commit</div><div class="highlight">Squash Commits…</div><div>Revert Commit</div><div class="danger">Reset to Commit</div></div>
          </div>
          <div class="git-footer"><span>{copy.gitExample.selected}</span><span>SHIFT + CLICK</span></div>
        </div>
      </div>
    </section>

    <section class="content-section squash-section">
      <div class="site-container">
        <header class="section-heading centered"><div class="kicker">{copy.squashKicker}</div><h2>{copy.squashTitle}</h2></header>
        <div class="squash-grid">
          <article class="squash-card">
            <div class="squash-badge">GIT HISTORY</div>
            <div class="commit-diagram" aria-hidden="true"><span>A</span><i></i><span class="selected-node">B</span><i class="selected-line"></i><span class="selected-node">C</span><b>→</b><span class="result-node">S</span></div>
            <h3>{copy.historySquashTitle}</h3><p>{copy.historySquashBody}</p>
            <div class="squash-meta"><span>PREVIEW</span><span>SAFETY CHECKS</span><span>UNDO</span></div>
          </article>
          <article class="squash-card featured">
            <div class="squash-badge">DELIVERY</div>
            <div class="delivery-diagram" aria-hidden="true"><div><small>WORKSPACE</small><span>●—●—●</span></div><b>→</b><div><small>TARGET</small><span>●——◆</span></div></div>
            <h3>{copy.deliverySquashTitle}</h3><p>{copy.deliverySquashBody}</p>
            <div class="squash-meta"><span>ONE COMMIT</span><span>SOURCE PRESERVED</span><span>RECOVERABLE</span></div>
          </article>
        </div>
        <p class="section-footnote">{copy.squashFootnote}</p>
      </div>
    </section>

    <section id="workflow" class="content-section section-grid border-section">
      <div class="site-container">
        <header class="section-heading wide"><div><div class="kicker">03 / {copy.workflowKicker}</div><h2>{copy.workflowTitle}</h2></div><p>{copy.workflowBody}</p></header>
        <div class="steps-grid">{copy.steps.map(([number, title, detail]) => <article><span>{number}</span><h3>{title}</h3><p>{detail}</p></article>)}</div>
        <div class="delivery-panel"><div class="delivery-header"><div><span>DELIVERY MODE</span><h3>{copy.deliveryTitle}</h3></div><code>PER REPOSITORY</code></div><div class="delivery-grid">{copy.deliveryModes.map(([name, detail, badge], index) => <article class={index === 0 ? 'selected' : ''}><div><span>0{index + 1}</span>{badge && <em>{badge}</em>}</div><h4>{name}</h4><p>{detail}</p></article>)}</div></div>
      </div>
    </section>

    <section id="agents" class="content-section section-grid">
      <div class="site-container split-layout reverse-on-mobile">
        <div class="terminal-window" role="img" aria-label={copy.terminalIllustrationLabel}>
          <div class="terminal-header"><div><i></i><strong>api · TTY</strong></div><span>RUNNING</span></div>
          <div class="terminal-body"><code><span>01</span><b>$</b> amux run --name api -- cargo run<br /><span>02</span><em>Compiling service...</em><br /><span>03</span><em>Listening on 127.0.0.1:3001</em><br /><span>04</span><strong>GET /api/health 200</strong><br /><span>05</span><em>{copy.agentSessionEnded}</em></code></div>
          <div class="terminal-footer"><span>PROJECT / ATLAS / API</span><span>LOGS · INPUT · STOP</span></div>
        </div>
        <div>
          <header class="section-heading compact"><div class="kicker">04 / {copy.agentsKicker}</div><h2>{copy.agentsTitle}</h2><p>{copy.agentsBody}</p></header>
          <ul class="check-list">{copy.agentPoints.map((item) => <li><span>✓</span>{item}</li>)}</ul>
          <small class="private-note">{copy.processNote}</small>
        </div>
      </div>
    </section>

    <section class="content-section border-section">
      <div class="site-container">
        <header class="section-heading"><div class="kicker">05 / {copy.scenariosKicker}</div><h2>{copy.scenariosTitle}</h2></header>
        <div class="scenario-grid">{copy.scenarios.map(([title, detail], index) => <article><span>0{index + 1}</span><h3>{title}</h3><p>{detail}</p></article>)}</div>
      </div>
    </section>

    <section class="cta-section section-grid"><div class="cta-orb"></div><div class="site-container"><div class="kicker">{copy.ctaKicker}</div><h2>{copy.ctaTitle}</h2><p>{copy.ctaBody}</p><div class="hero-actions"><a class="button button-primary" href={download}>{copy.ctaDownload}<span aria-hidden="true">↗</span></a><a class="button button-secondary" href={siteLinks.github} target="_blank" rel="noopener noreferrer">{copy.ctaSource}<span aria-hidden="true">↗</span></a></div></div></section>
  </main>
  <SiteFooter />
</BaseLayout>
