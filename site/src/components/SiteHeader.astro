---
import LinkIcon from './LinkIcon.astro';
interface Props {
  current?: 'home' | 'download';
}

import { siteLinks } from '../config/site';
import { commonCopy } from '../i18n/common';
import { getAlternateLocale, getLocalizedPath, localeMeta, normalizeLocale } from '../i18n/config';

const { current = 'home' } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const alternateLocale = getAlternateLocale(locale);
const home = getLocalizedPath(locale, 'home');
const download = getLocalizedPath(locale, 'download');
const languageTarget = getLocalizedPath(alternateLocale, current);
const copy = commonCopy[locale].header;
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href={home} class="brand" aria-label={copy.homeLabel}>
      <img src="/favicon.png" width="28" height="28" alt="" />
      <span>Treefold</span>
    </a>

    <nav class="desktop-nav" aria-label={copy.primaryNavigationLabel}>
      <a href={`${home}#model`}>{copy.model}</a>
      <a href={`${home}#git`}>{copy.git}</a>
      <a href={`${home}#workflow`}>{copy.workflow}</a>
      <a href={`${home}#agents`}>{copy.agents}</a>
    </nav>

    <div class="header-actions">
      <a class="language-switch" href={languageTarget} lang={localeMeta[alternateLocale].htmlLang} aria-label={copy.switchLanguageLabel}>{copy.languageLabel}</a>
      <a class="github-link" href={siteLinks.github} target="_blank" rel="noopener noreferrer" aria-label={copy.source} title={copy.source}><LinkIcon name="github" /></a>
      <a href={download} class="button button-compact" aria-current={current === 'download' ? 'page' : undefined}>{copy.download}<LinkIcon name="download" /></a>
    </div>

    <details class="mobile-menu">
      <summary aria-label={copy.menuLabel}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <nav aria-label={copy.mobileNavigationLabel}>
        <a href={`${home}#model`}>{copy.model}</a>
        <a href={`${home}#git`}>{copy.git}</a>
        <a href={`${home}#workflow`}>{copy.workflow}</a>
        <a href={`${home}#agents`}>{copy.agents}</a>
        <a href={download}>{copy.download}</a>
        <a href={siteLinks.github} target="_blank" class="external-link" rel="noopener noreferrer" aria-label="GitHub" title="GitHub"><LinkIcon name="github" /><LinkIcon /></a>
        <a href={languageTarget} lang={localeMeta[alternateLocale].htmlLang}>{copy.switchLanguageLabel}</a>
      </nav>
    </details>
  </div>
</header>
