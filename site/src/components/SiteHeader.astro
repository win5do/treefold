---
interface Props {
  current?: 'home' | 'download';
  locale?: 'zh' | 'en';
}

const { current = 'home', locale = 'zh' } = Astro.props;
const isEnglish = locale === 'en';
const home = isEnglish ? '/en/' : '/';
const download = isEnglish ? '/en/download/' : '/download/';
const languageTarget = current === 'download'
  ? (isEnglish ? '/download/' : '/en/download/')
  : (isEnglish ? '/' : '/en/');
const github = 'https://github.com/win5do/treefold';
const copy = isEnglish ? {
  home: 'Treefold home',
  model: 'Model',
  git: 'Git visibility',
  workflow: 'Workflow',
  agents: 'Agents',
  download: 'Download',
  menu: 'Open navigation',
  source: 'Source',
  language: '中文',
} : {
  home: 'Treefold 首页',
  model: '产品模型',
  git: 'Git 可视化',
  workflow: '工作方式',
  agents: 'Agent 集成',
  download: '下载',
  menu: '打开导航菜单',
  source: '源码',
  language: 'EN',
};
---

<header class="site-header">
  <div class="site-container header-inner">
    <a href={home} class="brand" aria-label={copy.home}>
      <img src="/favicon.png" width="28" height="28" alt="" />
      <span>Treefold</span>
    </a>

    <nav class="desktop-nav" aria-label={isEnglish ? 'Primary navigation' : '主导航'}>
      <a href={`${home}#model`}>{copy.model}</a>
      <a href={`${home}#git`}>{copy.git}</a>
      <a href={`${home}#workflow`}>{copy.workflow}</a>
      <a href={`${home}#agents`}>{copy.agents}</a>
    </nav>

    <div class="header-actions">
      <a class="language-switch" href={languageTarget} lang={isEnglish ? 'zh-CN' : 'en'} aria-label={isEnglish ? '切换到中文' : 'Switch to English'}>{copy.language}</a>
      <a class="github-link" href={github} target="_blank" rel="noopener noreferrer">{copy.source}</a>
      <a href={download} class="button button-compact" aria-current={current === 'download' ? 'page' : undefined}>{copy.download}<span aria-hidden="true">↗</span></a>
    </div>

    <details class="mobile-menu">
      <summary aria-label={copy.menu}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </summary>
      <nav aria-label={isEnglish ? 'Mobile navigation' : '移动端导航'}>
        <a href={`${home}#model`}>{copy.model}</a>
        <a href={`${home}#git`}>{copy.git}</a>
        <a href={`${home}#workflow`}>{copy.workflow}</a>
        <a href={`${home}#agents`}>{copy.agents}</a>
        <a href={download}>{copy.download}</a>
        <a href={github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={languageTarget} lang={isEnglish ? 'zh-CN' : 'en'}>{isEnglish ? '切换到中文' : 'Switch to English'}</a>
      </nav>
    </details>
  </div>
</header>
