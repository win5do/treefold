{
  "name": "treefold",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "edgedriver": false,
    "fsevents@2.3.3": true,
    "geckodriver": false
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:no-watch": "electron-vite dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && electron-vite build",
    "build:web": "vite build",
    "prepare:sidecars": "cargo xtask sidecars bundle",
    "bundle:desktop": "node scripts/bundle-desktop.mjs",
    "test:ui": "node tests/ui/run.mjs",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:backend": "cargo build --manifest-path backend/Cargo.toml",
    "test:desktop": "npm run build:backend && node --test tests/desktop/*.test.mjs",
    "test:backend": "cargo test --manifest-path backend/Cargo.toml",
    "test:electron": "node --test tests/electron/*.test.mjs",
    "start": "electron-vite preview",
    "typecheck:web": "tsc --noEmit",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@azurity/pure-nerd-font": "3.0.5",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "^1.3.1",
    "@pierre/theme": "^1.1.0",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.0.12",
    "electron-vite": "^5.0.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^7.3.6",
    "webdriverio": "^9.30.1"
  },
  "main": "out/main/index.cjs",
  "description": "Local-first workspace for parallel coding agents",
  "author": "Treefold contributors"
}
