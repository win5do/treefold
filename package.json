{
  "name": "treefold",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:no-watch": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "test:ui": "playwright test --project=ui",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:tools",
    "test:integration": "playwright test --project=integration",
    "test:electron": "playwright test --project=electron",
    "start": "electron-vite preview",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "postinstall": "node node_modules/electron/install.js",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.ui-tests.json"
  },
  "dependencies": {
    "@azurity/pure-nerd-font": "3.0.5",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pierre/diffs": "^1.3.1",
    "@pierre/theme": "^1.1.0",
    "@pierre/trees": "^1.0.0-beta.6",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.0.20",
    "electron-vite": "^5.0.0",
    "semver": "7.8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^7.3.6"
  },
  "main": "out/main/index.cjs",
  "description": "Local-first workspace for parallel coding agents",
  "author": "Treefold contributors",
  "engines": {
    "node": ">=24.12.0"
  }
}
