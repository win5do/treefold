{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "scripts/**/*.ts",
    "src/renderer/src/features/actions/model/app.ts",
    "src/renderer/src/features/actions/model/session.ts",
    "src/renderer/src/features/actions/model/metadata.ts",
    "src/renderer/src/features/actions/model/registry.ts",
    "tests/integration/**/*.ts",
    "tests/electron/**/*.ts",
    "src/preload/bridge.d.ts",
    "src/main/backend.ts",
    "src/main/open-in/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "scripts/rust-sidecars.ts"
  ]
}
